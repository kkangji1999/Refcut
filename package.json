{
  "name": "reftown",
  "productName": "Reftown",
  "version": "26.9.1109",
  "description": "영상에서 컷이 바뀔 때마다 대표 프레임을 자동으로 뽑아주는 도구 (레퍼런스 타운)",
  "main": "main.js",
  "author": "FreeWillusion",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/cuts.test.js && node test/grab.test.js && node test/stream.test.js && node test/quality.test.js && node test/notes.test.js",
    "test:app": "electron test/app.e2e.js && electron test/upgrade.e2e.js && electron test/fps.e2e.js",
    "test:format": "electron test/format.e2e.js",
    "test:link": "electron test/link.e2e.js",
    "test:preview": "electron test/preview.e2e.js",
    "test:yt": "electron test/yt.e2e.js",
    "test:copy": "electron test/copy.e2e.js",
    "test:edit": "electron test/edit.e2e.js",
    "test:av": "electron test/av.e2e.js",
    "test:quit": "electron test/quit.e2e.js",
    "test:vidbtn": "electron test/vidbtn.e2e.js",
    "test:name": "electron test/name.e2e.js",
    "test:audio": "electron test/audio.e2e.js",
    "test:ctl": "electron test/ctl.e2e.js",
    "test:archive": "electron test/archive.e2e.js",
    "test:guide": "electron test/guide.e2e.js",
    "test:premiere": "electron test/premiere.e2e.js",
    "test:tvcf": "electron test/tvcf.e2e.js",
    "test:vimeo": "electron test/vimeo.e2e.js",
    "bin": "node scripts/fetch-bin.js",
    "bin:force": "node scripts/fetch-bin.js --force",
    "dist": "npm run bin && electron-builder --win --x64",
    "dist:dir": "npm run bin && electron-builder --dir",
    "release": "npm run bin && electron-builder --win --x64 --publish always && node scripts/release-notes.js",
    "release:notes": "node scripts/release-notes.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.freewillusion.refcut",
    "productName": "Reftown",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.*",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kkangji1999",
        "repo": "Refcut",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "yt-dlp*",
          "qjs*",
          "!*.part"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "bin",
        "filter": [
          "ffmpeg*",
          "!**/*.md",
          "!package.json",
          "!index.js"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reftown"
    },
    "releaseInfo": {
      "releaseNotes": "이번에 바뀐 내용\n\n\n★ 긴 TVCF 광고도 유튜브의 같은 영상을 찾아냅니다\n\n  TVCF 영상을 넣으면 유튜브에 워터마크 없는 같은 영상이 있는지 찾아 주는데,\n  2분 30초가 넘는 광고는 유튜브에 똑같은 영상이 있어도\n  \"유튜브에 똑같은 영상은 없습니다\" 가 떴습니다.\n    · 영상 길이를 잘못 재서 길이가 안 맞는다고 걸러 버리고 있었습니다\n    · 이제 실제 길이로 비교합니다\n      (예: 문화체육관광부 IT'S THE KOREAN WAY 3분 8초 → 유튜브 원본을 찾아 줍니다)\n\n\n※ 설치할 때 윈도우가 '알 수 없는 게시자' 라고 물으면\n   [추가 정보] → [실행] 을 눌러주세요. 서명 인증서가 없어서 뜨는 창입니다."
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "ffmpeg-static@5.3.0": true
  }
}
