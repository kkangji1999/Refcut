{
  "name": "reftown",
  "productName": "Reftown",
  "version": "26.8.2505",
  "description": "영상에서 컷이 바뀔 때마다 대표 프레임을 자동으로 뽑아주는 도구 (레퍼런스 타운)",
  "main": "main.js",
  "author": "FreeWillusion",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/cuts.test.js && node test/grab.test.js",
    "test:app": "electron test/app.e2e.js",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --dir",
    "release": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.freewillusion.refcut",
    "productName": "Reftown",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.*",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kkangji1999",
        "repo": "Refcut",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "bin",
        "filter": [
          "ffmpeg*",
          "!**/*.md",
          "!package.json",
          "!index.js"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reftown"
    },
    "releaseInfo": {
      "releaseNotes": "이번에 바뀐 내용\n\n· 이름이 Reftown(레프타운) 으로 바뀌었습니다\n· ffmpeg 가 깔려 있지 않은 컴퓨터에서 추출이 아예 안 되던 것을 고쳤습니다 — 가장 큰 문제였습니다\n· [폴더에서 고르기] 로 영상을 넣으면 아무 일도 일어나지 않던 것을 고쳤습니다\n· 주소를 붙여넣고 Enter 만 눌러도 대기열에 들어갑니다\n· 주소 넣는 칸을 눈에 띄게 키웠습니다\n· 주소로 넣은 영상(TVCF 등)도 대기열에 미리보기 그림이 뜹니다\n· 받다가 응답이 끊기면 끝없이 기다리지 않고 다른 방식으로 넘어갑니다"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "ffmpeg-static@5.3.0": true
  }
}
